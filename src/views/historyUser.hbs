<!DOCTYPE html>

<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lịch sử quản trị nhiệm vụ</title>

<link rel="stylesheet" href="/css/adminhistorytasks.css">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
    crossorigin="anonymous">

</head>

<body>

<div class="admin-layout">
<aside class="sidebar">

    <div class="sidebar-header">
        <h2>Admin</h2>
        <p>Quản trị hệ thống</p>
    </div>

    <ul class="nav flex-column">

        <li class="nav-item">
            <a class="nav-link" href="/manager/users">
                Quản lý người dùng
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="/manager/tasks">
                Quản lý nhiệm vụ
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link active" href="/manager/tasks/history">
                Lịch sử nhiệm vụ
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link logout-link" href="/logout" id="logout-btn">
                Đăng xuất
            </a>
        </li>

    </ul>

</aside>

<main class="content">

    <div class="page-header">

        <div>
            <h1>Lịch sử quản trị nhiệm vụ</h1>
            <p>Theo dõi các thao tác thêm, sửa và xóa nhiệm vụ.</p>
        </div>

    </div>

    <div class="history-card">

        <div class="table-responsive">

            <table class="table history-table align-middle">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Người thực hiện</th>
                        <th>Hành động</th>
                        <th>Nhiệm vụ</th>
                        <th>Tiêu đề nhiệm vụ</th>
                        <th>Thay đổi</th>
                        <th>Thời gian</th>
                    </tr>
                </thead>

                <tbody>

                    {{#each logs}}

                    <tr>

                        <td>
                            <span class="log-id">
                                #{{id}}
                            </span>
                        </td>

                        <td>
                            <span class="actor">
                                {{actor}}
                            </span>
                        </td>

                        <td>

                            {{#if (eq action "Thêm")}}
                                <span class="action-badge action-create">
                                    Thêm
                                </span>
                            {{else if (eq action "Sửa")}}
                                <span class="action-badge action-update">
                                    Sửa
                                </span>
                            {{else if (eq action "Xóa")}}
                                <span class="action-badge action-delete">
                                    Xóa
                                </span>
                            {{else}}
                                <span class="action-badge">
                                    {{action}}
                                </span>
                            {{/if}}

                        </td>

                        <td>
                            {{#if task_id}}
                                #{{task_id}}
                            {{else}}
                                <span class="text-muted">
                                    Không còn tồn tại
                                </span>
                            {{/if}}
                        </td>

                        <td>
                            <strong>
                                {{task_title}}
                            </strong>
                        </td>

                        <td>

                            <details class="changes-details">

                                <summary>
                                    Xem thay đổi
                                </summary>

                                <div class="changes-box">

                                    {{#if changes.new}}

                                        <div class="change-title">
                                            Dữ liệu mới
                                        </div>

                                        {{#if changes.new.title}}
                                            <div>
                                                <strong>Tiêu đề:</strong>
                                                {{changes.new.title}}
                                            </div>
                                        {{/if}}

                                        {{#if changes.new.description}}
                                            <div>
                                                <strong>Mô tả:</strong>
                                                {{changes.new.description}}
                                            </div>
                                        {{/if}}

                                        {{#if changes.new.reward}}
                                            <div>
                                                <strong>Reward:</strong>
                                                {{changes.new.reward}}
                                            </div>
                                        {{/if}}

                                        {{#if changes.new.cooldown}}
                                            <div>
                                                <strong>Cooldown:</strong>
                                                {{changes.new.cooldown}}
                                            </div>
                                        {{/if}}

                                        {{#if changes.new.url}}
                                            <div class="url-value">
                                                <strong>URL:</strong>
                                                {{changes.new.url}}
                                            </div>
                                        {{/if}}

                                    {{/if}}


                                    {{#if changes.old}}

                                        <div class="change-title">
                                            Dữ liệu cũ
                                        </div>

                                        {{#if changes.old.title}}
                                            <div>
                                                <strong>Tiêu đề:</strong>
                                                {{changes.old.title}}
                                            </div>
                                        {{/if}}

                                        {{#if changes.old.description}}
                                            <div>
                                                <strong>Mô tả:</strong>
                                                {{changes.old.description}}
                                            </div>
                                        {{/if}}

                                        {{#if changes.old.reward}}
                                            <div>
                                                <strong>Reward:</strong>
                                                {{changes.old.reward}}
                                            </div>
                                        {{/if}}

                                        {{#if changes.old.cooldown}}
                                            <div>
                                                <strong>Cooldown:</strong>
                                                {{changes.old.cooldown}}
                                            </div>
                                        {{/if}}

                                        {{#if changes.old.url}}
                                            <div class="url-value">
                                                <strong>URL:</strong>
                                                {{changes.old.url}}
                                            </div>
                                        {{/if}}

                                    {{/if}}

                                </div>

                            </details>

                        </td>

                        <td>
                            <span class="time">
                                {{create_at}}
                            </span>
                        </td>

                    </tr>

                    {{else}}

                    <tr>

                        <td colspan="7" class="empty-state">
                            Chưa có lịch sử quản trị nhiệm vụ.
                        </td>

                    </tr>

                    {{/each}}

                </tbody>

            </table>

        </div>

    </div>

</main>

</div>

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous">
</script>

<script src="/js/logout.js"></script>

</body>

</html>
