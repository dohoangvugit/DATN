<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <title>MATIC FAUCET</title>
    <link rel="stylesheet" href="/css/client.css">
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg px-4">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <img src="/img/logo.png" alt="Logo" width="68" height="68">
                </a>

                <div class="ms-auto">
                    <a href="/logout" class="btn btn-outline-danger d-flex align-items-center" id="logout-btn">
                        <i class="bi bi-box-arrow-right"></i>
                        <span class="ms-2">Logout</span>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-5">
        <div class="row">

            <div class="col-xl-3 col-lg-4 col-md-5 mb-4">
                <div id="sidebar-block" class="box-shadow box-style text-white p-3 rounded">
                    <div class="user mb-3">
                        <div class="info">
                            <span class="fw-bold fs-5">{{username.username}}</span>
                        </div>
                    </div>

                    <div class="inner mb-3">
                        <div class="block">
                            <div class="data">
                                <div class="col-12">
                                    Balance
                                    <div class="fw-bold fs-4 text-warning" id="balance">{{balance.balance}}</div>
                                </div>
                            </div>
                        </div>

                        <a href="/withdraw" class="btn btn-success btn-sm w-100 mt-3">
                            Withdraw
                        </a>
                        <button type="button" class="btn btn-outline-light btn-sm w-100 mt-2" id="enable-advertiser">
                            Advertiser? Click here!!!
                        </button>
                        <div class="small mt-2" id="enable-advertiser-message" role="status"></div>
                    </div>
                </div>
            </div>

            <div class="col-xl-9 col-lg-8 col-md-7">
                <div class="row">

                    {{#each tasks}}
                    <div class="col-sm-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm d-flex flex-column">
                            
                            <div class="card-header bg-light fw-bold text-center text-truncate">
                                {{title}} 
                            </div>

                            <div class="card-body text-center flex-grow-1 d-flex align-items-center justify-content-center">
                                <p class="card-text text-muted mb-0">{{description}}</p>
                            </div>

                            <div class="card-footer bg-white border-top-0">
                                <div class="d-flex justify-content-between align-items-center mb-2 small text-secondary">
                                    <span><i class="bi bi-coin text-warning"></i> {{reward}}</span>
                                    <span><i class="bi bi-alarm-fill"></i> {{cooldown}}s</span>
                                </div>

                                <button
                                    class="btn btn-success btn-sm w-100 visit-btn"
                                    data-task-id="{{id}}"
                                    data-link-url="{{url}}"
                                    data-cooldown="{{cooldown}}">
                                    Visit
                                </button>
                            </div>
                        </div>            
                    </div>
                    {{/each}}

                </div>
            </div>

        </div>
    </div>

    <script src="/js/handleVisit.js"></script>
    <script src="/js/logout.js"></script>
    <script src="/js/enableAdvertiser.js"></script>
</body>
</html>