<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <title>MATIC FAUCET</title>
    <link rel="stylesheet" href="/css/home.css">
</head>

<body>
    <header>
        <nav class="navbar">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <img src="/img/logo.png" alt="Logo" width="68" height="68">
                <div>
                    <a href="/login" class="btn btn-outline-primary me-2">Sign In</a>
                    <a href="/register" class="btn btn-primary">Register</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="bg-hero"></div>

    <div class="container">
        <div class="main-content">
            <div class="stat-wrapper">

                <div class="stat-left">
                    <div class="stat-card">
                        <div class="title">Total Paid</div>
                        <div class="value">$</div>
                    </div>

                    <div class="stat-card">
                        <div class="title">Total User</div>
                        <div class="value">
                            <i class="bi bi-person"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card intro-card">
                    <div class="title">MAKE GAS FEE</div>
                    <ul class="intro-list">
                        <li>Earn Matic per click</li>
                        <li>Pay to Direct wallet</li>
                        <li>Payout very fast</li>
                        <li>No investment required</li>
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
</body>
</html>