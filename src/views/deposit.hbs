<!DOCTYPE html>
<html lang="vi">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Nạp tiền</title>

    <link rel="stylesheet" href="../css/deposit.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script src="../js/deposit.js" defer></script>
</head>

<body>
    <div class="sidebar">
        <a href="/advertiser" class="side-link">
            <i class="bi bi-grid-1x2-fill"></i>
            <span>Tổng quan</span>
        </a>

        <a href="#tasks" class="side-link">
            <i class="bi bi-megaphone"></i>
            <span>Quản lý nhiệm vụ</span>
        </a>

        <a href="deposit.html" class="side-link active">
            <i class="bi bi-wallet2"></i>
            <span>Nạp tiền</span>
        </a>

        <a href="#history" class="side-link">
            <i class="bi bi-clock-history"></i>
            <span>Lịch sử giao dịch</span>
        </a>

        <a href="/logout" class="side-link">
            <i class="bi bi-box-arrow-right"></i>
            <span>Đăng xuất</span>
        </a>
    </div>

    <div class="main">
        <div class="content">
            <div class="row">
                <div class="col-xl-8 col-lg-9 col-md-12">

                    <div class="stat-card deposit-card">
                        <hr class="deposit-divider">

                        <div class="deposit-section-title">
                            Chọn đồng tiền nạp
                        </div>

                        <div class="deposit-form-panel">

                            <!-- Chọn đồng tiền -->
                            <div class="coin-selection">

                                <div class="coin-card active">

                                    <img
                                        class="coin-logo"
                                        src="https://assets.coingecko.com/coins/images/32440/large/polygon.png"
                                        alt="POL"
                                        onerror="this.onerror=null;this.src='https://assets.coingecko.com/coins/images/4713/large/matic-token-icon.png';">

                                    <span class="coin-info">
                                        <strong>POL</strong>
                                        <small>Polygon</small>
                                    </span>

                                    <i class="bi bi-check-circle-fill coin-check"></i>
                                </div>

                            </div>

                            <!-- Thông tin đồng tiền -->
                            <div class="selected-coin-heading">
                                <div>
                                    <h5 id="depositTitle">Nạp POL</h5>

                                    <p id="depositDescription">
                                        Chuyển POL trên mạng Polygon vào ví hệ thống.
                                    </p>
                                </div>

                                <span class="network-badge" id="networkBadge">
                                    Polygon PoS
                                </span>
                            </div>

                            <!-- Form nạp tiền -->
                            <form id="depositForm" action="/deposit" method="POST">

                                <input
                                    type="hidden"
                                    name="currency"
                                    id="currencyInput"
                                    value="POL">

                                <div class="form-group">
                                    <label for="txHashInput" class="deposit-label">
                                        Mã giao dịch (TxHash)
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control deposit-input"
                                        name="txhash"
                                        id="txHashInput"
                                        placeholder="0x..."
                                        autocomplete="off"
                                        required>

                                    <small
                                        class="form-text text-muted"
                                        id="txHashHelp">
                                        Nhập mã giao dịch POL trên mạng Polygon.
                                    </small>
                                </div>

                                <button
                                    type="submit"
                                    class="btn btn-primary btn-block deposit-submit"
                                    id="depositSubmit">

                                    <i class="bi bi-check-circle mr-2"></i>
                                    Xác nhận nạp tiền
                                </button>

                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>