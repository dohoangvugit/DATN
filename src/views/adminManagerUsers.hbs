<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý người dùng</title>
    <link rel="stylesheet" href="/css/adminmanager.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    
<div class="container text-center mt-4">
  <div class="row align-items-start">
    <div class="col-2">
        <h1>Admin</h1>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link active" href="/manager/users">Quản lý người dùng</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/manager/tasks">Quản lý nhiệm vụ</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/logout" id="logout-btn">Đăng xuất</a>
            </li>
        </ul>
    </div>

    <div class="col-10 text-start">
        <h2>Quản lý người dùng</h2>
        <a class="nav-link mb-3" href="/manager/history/users">Lịch sử</a>
        <div id="manager-message" class="alert d-none" role="status"></div>

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Username</th>
                    <th scope="col">Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Balance</th>
                    <th scope="col">Ad_Balance</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                {{#each people}}
                <tr>
                    <th scope="row">{{id}}</th>
                    <td>{{username}}</td>
                    <td>{{email}}</td>
                    <td>
                        {{role}}
                        {{#if ../isSuperadmin}}
                        <div class="input-group input-group-sm mt-2">
                            <select class="form-select" data-role-select>
                                <option value="{{role}}" selected>{{role}}</option>
                                <option value="Viewer">Viewer</option>
                                <option value="Advertiser">Advertiser</option>
                                <option value="Admin">Admin</option>
                                <option value="Superadmin">Superadmin</option>
                            </select>
                            <button type="button" class="btn btn-outline-success" data-update-role="{{id}}">Lưu</button>
                        </div>
                        {{/if}}
                    </td>
                    <td>{{balance}}</td>
                    <td>{{ad_balance}}</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-danger" data-delete-user="{{id}}" data-username="{{username}}">Xóa</button>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<script src="/js/logout.js"></script>
<script src="/js/adminManagerUsers.js"></script>
</body>
</html>